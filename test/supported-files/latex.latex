\section{Stochastic Differential Systems}

Let $\{\mathbf{x}_t\}_{t=0}^{T}$ follow
$\mathbf{x}_{t+1} = f_t(\mathbf{x}_t, \mathbf{u}_t) + \boldsymbol{\epsilon}_t$
with $\boldsymbol{\epsilon}_t \sim \mathcal{N}(0, \Sigma_t)$.

\begin{align}
\mathbf{x}_{t+1}
&= A_t\mathbf{x}_t + B_t\mathbf{u}_t + \mathbf{b}_t
+ \mathbf{G}_t\boldsymbol{\epsilon}_t \\
\mathbb{E}[\mathbf{x}_{t+1}|\mathbf{x}_t]
&= A_t\mathbf{x}_t + B_t\mathbf{u}_t + \mathbf{b}_t
\end{align}

\begin{equation}
\mathcal{L}(\mathbf{u}) =
\sum_{t=0}^{T-1}\left(
\|\mathbf{x}_t-\mathbf{x}_t^\star\|_{Q_t}^2
+ \|\mathbf{u}_t\|_{R_t}^2
+ \eta\,\|\mathbf{u}_{t+1}-\mathbf{u}_t\|_2^2
\right)
+ \|\mathbf{x}_T-\mathbf{x}_T^\star\|_{Q_T}^2
\end{equation}

\subsection{Piecewise Penalty and Feasibility}

\begin{equation}
\psi_{\delta}(s)=
\begin{cases}
\dfrac{s^2}{2\delta}, & |s|\le\delta \\
|s|-\dfrac{\delta}{2}, & |s|>\delta
\end{cases}
\end{equation}

\begin{equation}
\mathcal{C}=\left\{\mathbf{u}\in\mathbb{R}^m\mid
\underline{\mathbf{u}}\le\mathbf{u}\le\overline{\mathbf{u}},
\ A_{\mathrm{ineq}}\mathbf{u}\le\mathbf{c}\right\}
\end{equation}

\section{Geometry and Curvature}

\begin{align}
\Gamma^{k}_{ij}
&= \frac{1}{2}g^{k\ell}(\partial_i g_{j\ell}+\partial_j g_{i\ell}-\partial_\ell g_{ij}) \\
R_{ij}
&= \partial_k\Gamma^{k}_{ij}-\partial_j\Gamma^{k}_{ik}
+\Gamma^{k}_{k\ell}\Gamma^{\ell}_{ij}-\Gamma^{k}_{j\ell}\Gamma^{\ell}_{ik}
\end{align}

\begin{equation}
\mathcal{S}_{\mathrm{EH}} = \int_{\mathcal{M}} (R - 2\Lambda)\sqrt{-g}\,d^4x
+ \int_{\partial\mathcal{M}} K\sqrt{|h|}\,d^3x
\end{equation}

\section{Linear Algebra and Spectral Structure}

\begin{equation}
\chi_A(\lambda)=\det(\lambda I-A),\qquad
A = V\Lambda V^{-1},\qquad
\Lambda = \operatorname{diag}(\lambda_1,\dots,\lambda_n)
\end{equation}

\begin{align}
\sigma_{\max}(A)
&= \sqrt{\lambda_{\max}(A^\top A)} \\
\kappa_2(A)
&= \frac{\sigma_{\max}(A)}{\sigma_{\min}(A)}
\end{align}

\section{Bayesian Inference and Information Theory}

\begin{align}
p(\mathbf{z},\mathbf{x}) &= p(\mathbf{x}|\mathbf{z})p(\mathbf{z}) \\
\log p(\mathbf{x})
&\ge \mathbb{E}_{q(\mathbf{z}|\mathbf{x})}[\log p(\mathbf{x}|\mathbf{z})]
- D_{\mathrm{KL}}(q(\mathbf{z}|\mathbf{x})\|p(\mathbf{z}))
\end{align}

\begin{equation}
I(X;Y)=\sum_{x,y}p(x,y)\log\frac{p(x,y)}{p(x)p(y)},\qquad
H(X)=-\sum_x p(x)\log_2 p(x)
\end{equation}

\section{Numerical Stability Identities}

\begin{multline}
\left(\Sigma + UCV^\top\right)^{-1}
= \Sigma^{-1} - \Sigma^{-1}U\left(C^{-1}+V^\top\Sigma^{-1}U\right)^{-1}V^\top\Sigma^{-1} \\
\log\det\left(\Sigma + UCV^\top\right)
= \log\det(\Sigma) + \log\det\left(C^{-1}+V^\top\Sigma^{-1}U\right) + \log\det(C)
\end{multline}

\subsection{Inline Formula Stress}

Inline checks:
$\oint_{\partial\Omega}\mathbf{F}\cdot d\mathbf{S}=\int_{\Omega}\nabla\cdot\mathbf{F}\,dV$,
$\int_{-\infty}^{\infty}e^{-x^2}\,dx=\sqrt{\pi}$,
$\left\|\sum_{i=1}^{n}\alpha_i\mathbf{v}_i\right\|_2^2\le
\left(\sum_{i=1}^{n}|\alpha_i|\right)^2\max_i\|\mathbf{v}_i\|_2^2$.

\section{Appendix}

\begin{gather}
\sum_{k=1}^{n}k^3 = \left(\frac{n(n+1)}{2}\right)^2 \\
\zeta(2)=\frac{\pi^2}{6},\qquad
\zeta(4)=\frac{\pi^4}{90} \\
\nabla\times(\phi\mathbf{A}) = \nabla\phi\times\mathbf{A} + \phi(\nabla\times\mathbf{A})
\end{gather}

