%% ER model for 81-tribulation data
erDiagram
    MISSION ||--o{ TRIBULATION : contains
    TRIBULATION }o--|| LOCATION : occurs_at
    TRIBULATION }o--o{ ACTOR : involves
    TRIBULATION }o--o{ ARTIFACT : references
    ACTOR ||--o{ ALIAS : has
    LOCATION ||--o{ CHECKPOINT : includes

    MISSION {
      string mission_code PK
      string title
      string objective
      string origin
      string destination
      string completion_status
    }

    TRIBULATION {
      int tribulation_no PK
      string chapter_span
      string primary_cause
      string conflict_level
      string branch_path
      string outcome
      string cn_aux_note
    }

    LOCATION {
      string location_id PK
      string name
      string terrain
      string hazard_profile
      string governance_context
    }

    ACTOR {
      string actor_id PK
      string display_name
      string faction
      string role_type
      string status
    }

    ARTIFACT {
      string artifact_id PK
      string artifact_name
      string owner_actor_id
      string ability
      string risk
    }

    CHECKPOINT {
      string checkpoint_id PK
      string location_id FK
      string weather
      string supply_state
      string branch_flag
    }

    ALIAS {
      string alias_id PK
      string actor_id FK
      string alias_name
      string usage_context
    }
