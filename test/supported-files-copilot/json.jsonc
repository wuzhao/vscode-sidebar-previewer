{
  // [A] Root-level line comment before first property
  "meta": {
    "title": "Journey to the West - JSONC Deep Fixture", // [B] Inline trailing comment
    "focus": "Nested object-array-object shapes + mixed comment positions",
    "primaryLanguage": "English",
    "auxiliaryLanguage": [
      "Chinese"
    ]
  },

  /* [C] Block comment before array property */
  "routePlan": [
    // [D] Comment before first route object
    {
      "leg": "east-start",
      "checkpoints": [
        {
          "id": "CP-009",
          "location": "Black Wind Cave",
          "signals": [
            "forged-invitation",
            "hostage-rumor"
          ],
          "actors": [
            { "name": "Sun Wukong", "role": "defender" }, // [E] Trailing comment after inline object
            { "name": "Xuanzang", "role": "verification" }
          ],
          "fallback": {
            // [F] Object containing array containing objects
            "ifEvidenceLow": [
              { "action": "recon", "timeoutSec": 300 },
              { "action": "request-witness", "timeoutSec": 600 }
            ]
          }
        },
        /* [G] Block comment between array elements */
        {
          "id": "CP-012",
          "location": "Flower-Fruit Mountain",
          "signals": [
            "forged-seal"
          ],
          "actors": [
            { "name": "Zhu Bajie", "role": "support" },
            { "name": "Sha Wujing", "role": "rear-guard" }
          ],
          "fallback": {
            "ifHostage": [
              {
                "action": "protective-formation",
                "requires": [
                  "rear-lane-lock",
                  "monk-visual-anchor"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "leg": "final-approach",
      "checkpoints": [
        {
          "id": "CP-080",
          "location": "Small Thunderclap Monastery",
          "signals": [
            "illusion-spike"
          ],
          "actors": [
            { "name": "Sun Wukong", "role": "counter-illusion" },
            { "name": "Sha Wujing", "role": "escort-stability" }
          ]
        },
        {
          "id": "CP-081",
          "location": "Thunder Monastery",
          "signals": [
            "canon-verification"
          ],
          "actors": [
            { "name": "Xuanzang", "role": "canon-check" },
            { "name": "Sun Wukong", "role": "security" }
          ]
        }
      ]
    }
  ],

  "commentStyles": [
    "line-comment-above",
    /* [H] block comment inside array */
    "block-comment-between-items",
    /// [I] triple slash style line comment
    "triple-slash-line-comment",
    "bang-like textual marker !not-a-syntax-comment"
  ],

  "mixedPayload": {
    "objectContainsArray": [
      {
        "key": "route",
        "values": [
          "main-route",
          "branch-river-detour",
          "branch-west-ridge"
        ]
      },
      {
        "key": "priority",
        "values": [
          "civilian-safety",
          "evidence",
          "escort-integrity"
        ]
      }
    ],
    "arrayContainsObject": [
      {
        "cluster": "high-risk",
        "items": [
          { "cp": "CP-036", "score": 88.9 },
          { "cp": "CP-080", "score": 141.8 }
        ]
      },
      {
        "cluster": "verification",
        "items": [
          { "cp": "CP-081", "score": 52.1 }
        ]
      }
    ]
  },

  // [Z] Tail comment near the end of document
  "tailNote": "Aux CN: 注释样式与结构复杂度用于预览测试"
}
