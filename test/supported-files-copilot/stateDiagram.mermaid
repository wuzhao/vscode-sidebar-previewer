%% State machine for the Journey to the West mission lifecycle
stateDiagram-v2
    [*] --> MandateIssued
    MandateIssued --> TeamAssembled
    TeamAssembled --> EnRoute

    state EnRoute {
        [*] --> Recon
        Recon --> Negotiation : diplomatic contact
        Recon --> Combat : verified hostile intent
        Recon --> IllusionAudit : identity mismatch signs

        IllusionAudit --> Combat : confirmed hostile deception
        IllusionAudit --> Negotiation : false alarm resolved

        Negotiation --> Combat : treaty breach
        Negotiation --> Recovery : safe passage granted

        Combat --> Recovery : threat neutralized
        Combat --> Escalation : monk safety critical

        Escalation --> Mediation : bodhisattva channel opened
        Mediation --> Recovery

        Recovery --> RouteBranch
        RouteBranch --> Recon : main-route
        RouteBranch --> Recon : river-detour
        RouteBranch --> Recon : west-ridge
    }

    EnRoute --> CanonGate : reached Thunder Monastery
    CanonGate --> CanonVerification

    CanonVerification --> CanonCorrection : mismatch detected
    CanonCorrection --> CanonVerification

    CanonVerification --> ReturnRoute : canon validated
    ReturnRoute --> ArchiveTranslation
    ArchiveTranslation --> MissionComplete

    MissionComplete --> [*]
